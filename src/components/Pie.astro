---
import type { Indice } from "../lib/types";
import { fecha } from "../lib/format";

interface Props {
  indice: Indice | null;
}
const { indice } = Astro.props;
---

<footer class="mt-10 border-t border-[var(--color-linea)]">
  <div
    class="contenedor flex flex-wrap items-baseline gap-x-2 gap-y-1 py-5 text-[0.7rem] leading-relaxed text-[var(--color-tinta-tenue)]"
  >
    <span class="font-semibold tracking-wide text-[var(--color-tinta-suave)]">markap</span>
    <span aria-hidden="true">·</span>
    <span>
      Agregador de noticias. Cada una enlaza a su publicación original, cuyos
      derechos pertenecen al medio que la publicó.
    </span>
    {
      indice && (
        <time class="w-full sm:ms-auto sm:w-auto whitespace-nowrap" datetime={indice.generated_at}>
          Actualizado {fecha(indice.generated_at, true)}
        </time>
      )
    }
  </div>
</footer>
