---
import type { Indice } from "../lib/types";
import { fecha, numero } from "../lib/format";

interface Props {
  indice: Indice | null;
}
const { indice } = Astro.props;
---

<footer class="mt-8 border-t border-[var(--color-linea)] bg-[var(--color-lienzo)]">
  <div class="contenedor py-6">
    {
      indice && (
        <p class="mb-2 text-sm font-semibold">
          {numero(indice.total_articles)} noticias en {numero(indice.total_categories)} categorías
          <span class="font-normal text-[var(--color-tinta-tenue)]">
            · actualizado el {fecha(indice.generated_at, true)}
          </span>
        </p>
      )
    }
    <p class="max-w-[65ch] text-xs leading-relaxed text-[var(--color-tinta-tenue)]">
      markap es un agregador: reúne y ordena noticias publicadas por medios
      deportivos, y cada una enlaza a su publicación original. Los derechos de
      cada noticia pertenecen al medio que la publicó; markap no está afiliado
      a ninguno de ellos.
    </p>
  </div>
</footer>
