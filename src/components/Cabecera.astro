---
import type { Indice } from "../lib/types";
import { enlaceCategoria, etiquetaCategoria, nombreCategoria } from "../lib/format";
import { SITIO } from "../lib/sitio";
import Logo from "./Logo.astro";

interface Props {
  indice: Indice | null;
  categoriaActiva?: string;
}

const { indice, categoriaActiva } = Astro.props;

// Secciones principales de la barra: las cabeceras de primer nivel con mas
// noticias archivadas.
const principales = [...new Set((indice?.categories ?? []).map((c) => c.category.split("/")[0]!))]
  .map((raiz) => ({
    raiz,
    total: (indice?.categories ?? [])
      .filter((c) => c.category === raiz || c.category.startsWith(`${raiz}/`))
      .reduce((suma, c) => suma + c.articles, 0),
  }))
  .sort((a, b) => b.total - a.total)
  .slice(0, 10);
---

<header
  data-cabecera
  class="app-cabecera sticky top-0 z-20 border-b border-[var(--color-linea)] bg-[var(--color-lienzo)]/95 backdrop-blur"
>
  <div class="contenedor flex flex-wrap items-center gap-x-3 gap-y-2 py-3">
    <a
      href="/"
      class="flex min-w-0 flex-1 items-center gap-3 sm:me-auto sm:flex-none"
      aria-label={`${SITIO.nombre}, ir a la portada`}
    >
      <Logo clase="size-9 shrink-0 text-[var(--color-marca)]" />
      <span class="flex min-w-0 flex-col">
        <strong class="font-display text-2xl font-extrabold lowercase leading-[1.15] tracking-tight">
          {SITIO.nombre}
        </strong>
        <small
          class="mt-[3px] truncate text-[0.62rem] uppercase leading-tight tracking-[0.14em] text-[var(--color-tinta-tenue)]"
        >
          {SITIO.lema}
        </small>
      </span>
    </a>

    <!-- En móvil el buscador y el tema viven en la barra de pestañas de abajo
         (BarraApp.astro): la cabecera se queda en logo y secciones, como en una app. -->
    <form
      action="/buscar"
      method="get"
      role="search"
      class="hidden lg:ml-auto lg:block lg:w-auto lg:max-w-sm lg:flex-1"
    >
      <label for="q" class="sr-only">Buscar noticias</label>
      <div class="relative">
        <svg
          class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 stroke-[var(--color-tinta-tenue)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Buscar titulares, autores, etiquetas…"
          autocomplete="off"
          class="w-full rounded-full border border-[var(--color-linea)] bg-[var(--color-lienzo-alt)] py-2 pl-9 pr-4 text-sm outline-none placeholder:text-[var(--color-tinta-tenue)] focus:border-[var(--color-marca)] focus:bg-[var(--color-lienzo)]"
        />
      </div>
    </form>

    <button
      type="button"
      id="cambiar-tema"
      data-cambiar-tema
      aria-label="Cambiar entre tema claro y oscuro"
      class="hidden lg:grid size-9 shrink-0 place-items-center rounded-full border border-[var(--color-linea)] text-[var(--color-tinta-suave)] hover:border-[var(--color-marca)] hover:text-[var(--color-marca)]"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
      </svg>
    </button>
  </div>

  {
    principales.length > 0 && (
      <nav
        aria-label="Secciones"
        data-secciones
        class="contenedor flex snap-x snap-mandatory gap-1.5 overflow-x-auto pb-2 text-sm [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        <a
          href="/"
          aria-current={!categoriaActiva ? "page" : undefined}
          class:list={[
            "shrink-0 scroll-mx-4 snap-start rounded-full px-3.5 py-1.5 font-semibold",
            !categoriaActiva
              ? "bg-[var(--color-marca)] text-white"
              : "text-[var(--color-tinta-suave)] hover:bg-[var(--color-lienzo-alt)]",
          ]}
        >
          Portada
        </a>
        {principales.map(({ raiz }) => (
          <a
            href={enlaceCategoria(raiz)}
            title={nombreCategoria(raiz)}
            aria-current={
              categoriaActiva === raiz || categoriaActiva?.startsWith(`${raiz}/`) ? "page" : undefined
            }
            class:list={[
              "shrink-0 scroll-mx-4 snap-start rounded-full px-3.5 py-1.5 font-semibold",
              categoriaActiva === raiz || categoriaActiva?.startsWith(`${raiz}/`)
                ? "bg-[var(--color-marca)] text-white"
                : "text-[var(--color-tinta-suave)] hover:bg-[var(--color-lienzo-alt)]",
            ]}
          >
            {etiquetaCategoria(raiz)}
          </a>
        ))}
      </nav>
    )
  }
</header>

<script is:inline>
  // La sección en la que estás puede quedar fuera de la parte visible de la
  // barra: se centra sola al cargar, sin arrastrar la página.
  (function () {
    var barra = document.querySelector("[data-secciones]");
    var activa = barra && barra.querySelector('[aria-current="page"]');
    if (!activa) return;
    var centro = activa.offsetLeft - (barra.clientWidth - activa.clientWidth) / 2;
    barra.scrollTo({ left: Math.max(0, centro), behavior: "instant" in document.body.style ? "instant" : "auto" });
  })();

  // Hay dos botones de tema: el de la cabecera (escritorio) y el de la barra
  // de pestañas (móvil).
  document.addEventListener("click", (evento) => {
    if (!evento.target.closest("[data-cambiar-tema]")) return;
    const oscuro = document.documentElement.classList.toggle("oscuro");
    window.pintarBarraEstado?.();
    // Con el almacenamiento bloqueado el tema cambia igual, solo que no se
    // recuerda al cambiar de pagina. Guardarlo sin red lanzaba en la consola.
    try {
      localStorage.setItem("tema", oscuro ? "oscuro" : "claro");
    } catch (e) {}
  });

  // En móvil la cabecera se esconde al bajar leyendo y vuelve al subir un
  // poco, como en las apps de noticias: deja toda la pantalla al texto.
  (function () {
    var cabecera = document.querySelector("[data-cabecera]");
    var movil = window.matchMedia("(max-width: 1023px)");
    if (!cabecera) return;
    var ultima = scrollY;
    var pendiente = false;
    addEventListener(
      "scroll",
      function () {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(function () {
          pendiente = false;
          var y = scrollY;
          var oculta = movil.matches && y > 160 && y > ultima + 4;
          var visible = y < ultima - 4 || y < 160 || !movil.matches;
          if (oculta) cabecera.classList.add("app-cabecera-oculta");
          else if (visible) cabecera.classList.remove("app-cabecera-oculta");
          ultima = y;
        });
      },
      { passive: true },
    );
  })();
</script>
