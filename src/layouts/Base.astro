---
import "../styles/global.css";
import Cabecera from "../components/Cabecera.astro";
import Pie from "../components/Pie.astro";
import Seo from "../components/Seo.astro";
import Anuncios from "../components/Anuncios.astro";
import type { Indice } from "../lib/types";
import { SITIO } from "../lib/sitio";

interface Props {
  titulo: string;
  descripcion?: string;
  /** Ruta canónica de esta página. */
  canonical: string;
  indice: Indice | null;
  /** Segundos que el edge de Cloudflare puede reutilizar la respuesta. */
  cache?: number;
  categoriaActiva?: string;
  imagen?: string | null;
  tipo?: "website" | "article";
  publicado?: string | null;
  modificado?: string | null;
  autores?: string[];
  seccion?: string;
  etiquetas?: string[];
  noindex?: boolean;
  jsonLd?: object[];
  anterior?: string | null;
  siguiente?: string | null;
}

const {
  titulo,
  descripcion = SITIO.descripcion,
  canonical,
  indice,
  cache = 900,
  categoriaActiva,
  ...seo
} = Astro.props;

// El dataset se regenera cada dos horas: servir desde el edge y revalidar en
// segundo plano mantiene el sitio rápido sin quedarse obsoleto.
Astro.response.headers.set(
  "Cache-Control",
  `public, max-age=60, s-maxage=${cache}, stale-while-revalidate=86400`,
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo titulo={titulo} descripcion={descripcion} canonical={canonical} {...seo} />

    <link rel="dns-prefetch" href="https://www.highperformanceformat.com" />
    <link rel="dns-prefetch" href="https://pl30939588.effectivecpmnetwork.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#d8232a" />

    <script is:inline>
      // Las fotos las sirve cada medio de origen: si alguna desaparece, se
      // oculta en vez de mostrar el icono de imagen rota.
      addEventListener(
        "error",
        (evento) => {
          if (evento.target instanceof HTMLImageElement) evento.target.style.visibility = "hidden";
        },
        true,
      );

      // Aplica el tema antes de pintar para que no haya destello.
      const guardado = localStorage.getItem("tema");
      const oscuro = guardado ? guardado === "oscuro" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("oscuro", oscuro);
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-[var(--color-marca)] focus:px-4 focus:py-2 focus:text-white"
    >
      Ir al contenido
    </a>

    <Cabecera indice={indice} categoriaActiva={categoriaActiva} />

    <main id="contenido" class="contenedor w-full flex-1 py-8">
      <slot />
    </main>

    <Pie indice={indice} />

    <Anuncios />
  </body>
</html>
