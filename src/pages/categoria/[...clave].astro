---
import Base from "../../layouts/Base.astro";
import Barra from "../../components/Barra.astro";
import Rejilla from "../../components/Rejilla.astro";
import Vacio from "../../components/Vacio.astro";
import Banner from "../../components/Banner.astro";
import { obtenerIndice, obtenerPaginaAgregada, obtenerPaginaCategoria } from "../../lib/data";
import { enlaceCategoria, nombreCategoria, numero } from "../../lib/format";
import { SITIO } from "../../lib/sitio";
import { grafoCategoria } from "../../lib/seo";

const POR_PAGINA = 24;

const clave = Astro.params.clave ?? "";
const indice = await obtenerIndice();
const entrada = indice?.categories.find((c) => c.category === clave);

// Algunas secciones no tienen noticias propias, solo subsecciones: «hockey»
// cuelga de hockey-hielo y hockey-patines. Sin esto, el enlace de la sección
// prometía noticias y llevaba a una página que no existía.
const hijas = (indice?.categories ?? []).filter((c) => c.category.startsWith(`${clave}/`));

if (!entrada && hijas.length === 0) {
  return new Response(null, { status: 404, statusText: "Categoría no encontrada" });
}

const solicitada = Number(Astro.url.searchParams.get("p") ?? "1");
const numeroPagina = Number.isFinite(solicitada) ? solicitada : 1;

const pagina = entrada
  ? await obtenerPaginaCategoria(entrada, numeroPagina, POR_PAGINA)
  : await obtenerPaginaAgregada(hijas, numeroPagina, POR_PAGINA);

const nombre = nombreCategoria(clave);
const sufijo = pagina.pagina > 1 ? ` (página ${pagina.pagina})` : "";
---

<Base
  titulo={`${nombre}: últimas noticias${sufijo} | ${SITIO.nombre}`}
  descripcion={`Toda la actualidad de ${nombre}: ${numero(pagina.total)} noticias reunidas de la prensa deportiva y ordenadas de la más reciente a la más antigua.`}
  canonical={enlaceCategoria(clave, pagina.pagina)}
  indice={indice}
  categoriaActiva={clave}
  anterior={pagina.pagina > 1 ? enlaceCategoria(clave, pagina.pagina - 1) : null}
  siguiente={pagina.pagina < pagina.paginas ? enlaceCategoria(clave, pagina.pagina + 1) : null}
  jsonLd={grafoCategoria(clave, nombre, pagina.articulos, pagina.pagina)}
>
  <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
    <aside class="order-2 lg:order-1 lg:sticky lg:top-28 lg:self-start">
      <Barra indice={indice} activa={clave} />
      <Banner hueco="vertical" clase="mt-6 hidden lg:flex" />
    </aside>

    <div class="order-1 lg:order-2">
      <header class="mb-6">
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-marca)]">Categoría</p>
        <h1 class="mt-1 font-display text-4xl font-extrabold uppercase tracking-tight">{nombre}</h1>
        <p class="mt-1 text-sm text-[var(--color-tinta-tenue)]">
          {numero(pagina.total)} noticias · página {pagina.pagina} de {pagina.paginas}
        </p>
      </header>

      {
        hijas.length > 0 && (
          <nav aria-label="Subsecciones" class="mb-6 flex flex-wrap gap-2">
            {hijas.map((hija) => (
              <a
                href={enlaceCategoria(hija.category)}
                class="rounded-full border border-[var(--color-linea)] px-3 py-1 text-xs font-semibold text-[var(--color-tinta-suave)] hover:border-[var(--color-marca)] hover:text-[var(--color-marca)]"
              >
                {nombreCategoria(hija.category.split("/").slice(1).join("/"))}
                <span class="ml-1 font-normal text-[var(--color-tinta-tenue)]">{numero(hija.articles)}</span>
              </a>
            ))}
          </nav>
        )
      }

      {
        hijas.length > 0 && (
          <nav aria-label="Subsecciones" class="mb-6 flex flex-wrap gap-2">
            {hijas.map((hija) => (
              <a
                href={enlaceCategoria(hija.category)}
                class="rounded-full border border-[var(--color-linea)] px-3 py-1 text-xs font-semibold text-[var(--color-tinta-suave)] hover:border-[var(--color-marca)] hover:text-[var(--color-marca)]"
              >
                {nombreCategoria(hija.category.split("/").slice(1).join("/"))}
                <span class="ml-1 font-normal text-[var(--color-tinta-tenue)]">
                  {numero(hija.articles)}
                </span>
              </a>
            ))}
          </nav>
        )
      }

      <Banner hueco="horizontal" clase="mb-7" />

      {
        pagina.articulos.length > 0 ? (
          <Rejilla articulos={pagina.articulos} anuncioCada={6} />
        ) : (
          <Vacio titulo="No hay noticias en esta página" />
        )
      }

      {
        pagina.paginas > 1 && (
          <nav class="mt-10 flex items-center justify-between gap-4" aria-label="Paginación">
            {pagina.pagina > 1 ? (
              <a
                href={enlaceCategoria(clave, pagina.pagina - 1)}
                class="rounded-full border border-[var(--color-linea)] px-4 py-2 text-sm font-semibold hover:border-[var(--color-marca)] hover:text-[var(--color-marca)]"
              >
                ← Más recientes
              </a>
            ) : (
              <span />
            )}

            <span class="text-sm text-[var(--color-tinta-tenue)]">
              {pagina.pagina} / {pagina.paginas}
            </span>

            {pagina.pagina < pagina.paginas ? (
              <a
                href={enlaceCategoria(clave, pagina.pagina + 1)}
                class="rounded-full border border-[var(--color-linea)] px-4 py-2 text-sm font-semibold hover:border-[var(--color-marca)] hover:text-[var(--color-marca)]"
              >
                Más antiguas →
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </div>
  </div>
</Base>
