---
import Base from "../layouts/Base.astro";
import Rejilla from "../components/Rejilla.astro";
import Vacio from "../components/Vacio.astro";
import { obtenerIndice, obtenerPortada } from "../lib/data";
import { numero } from "../lib/format";
import { SITIO } from "../lib/sitio";

// La consulta se enseña de vuelta y viaja en las etiquetas Open Graph. Astro
// escapa los atributos, así que no hay inyección, pero sin quitar los signos de
// menor y mayor cualquiera podría fabricar un enlace cuya vista previa en redes
// dijera lo que le diera la gana.
const consulta = (Astro.url.searchParams.get("q") ?? "")
  .replace(/[<>]/g, " ")
  .trim()
  .slice(0, 80);

const [indice, portada] = await Promise.all([
  obtenerIndice(),
  obtenerPortada(),
]);

// La busqueda recorre la portada (las 200 mas recientes): es instantanea y no
// obliga a descargar el archivo completo.
const normalizar = (texto: string) =>
  texto.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

const terminos = normalizar(consulta).split(/\s+/).filter(Boolean);

const resultados = !terminos.length
  ? []
  : (portada?.articles ?? []).filter((articulo) => {
      const heno = normalizar(
        [articulo.title, articulo.standfirst, articulo.summary, articulo.category, ...articulo.authors].join(" "),
      );
      return terminos.every((termino) => heno.includes(termino));
    });
---

<Base
  titulo={consulta ? `Resultados para «${consulta}» | ${SITIO.nombre}` : `Buscar noticias | ${SITIO.nombre}`}
  descripcion={`Busca entre las noticias deportivas más recientes de ${SITIO.nombre}.`}
  canonical="/buscar"
  indice={indice}
  cache={300}
  noindex
>
  <header class="mb-6">
    <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-marca)]">Búsqueda</p>
    <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight">
      {consulta ? `«${consulta}»` : "Buscar noticias"}
    </h1>
    <p class="mt-1 text-sm text-[var(--color-tinta-tenue)]">
      {
        consulta
          ? `${numero(resultados.length)} resultados entre las noticias más recientes`
          : "Escribe en el buscador de la cabecera para encontrar titulares, autores o etiquetas."
      }
    </p>
  </header>

  {
    consulta && resultados.length === 0 ? (
      <Vacio
        titulo="Sin resultados"
        detalle="La búsqueda cubre las noticias más recientes. Prueba con otros términos o entra por categoría."
      />
    ) : (
      resultados.length > 0 && <Rejilla articulos={resultados} />
    )
  }
</Base>
