---
import Base from "../layouts/Base.astro";
import Vacio from "../components/Vacio.astro";
import { obtenerIndice } from "../lib/data";
import { SITIO } from "../lib/sitio";

const indice = await obtenerIndice();
---

<Base
  titulo={`Página no encontrada | ${SITIO.nombre}`}
  canonical="/404"
  indice={indice}
  cache={3600}
  noindex
>
  <Vacio
    titulo="Esta página no existe"
    detalle="Puede que esa noticia ya no esté disponible. Vuelve a la portada o entra por categoría."
  />
  <p class="mt-6 text-center">
    <a
      href="/"
      class="rounded-full border border-[var(--color-linea)] px-4 py-2 text-sm font-semibold hover:border-[var(--color-marca)] hover:text-[var(--color-marca)]"
    >
      Ir a la portada
    </a>
  </p>
</Base>
